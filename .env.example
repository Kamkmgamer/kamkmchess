# Server-only configuration. Never expose these through Vite or browser files.
DATABASE_URL=postgres://kamkmchess:replace-me@127.0.0.1:5432/kamkmchess?sslmode=disable
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_AUTHORIZED_PARTIES=http://localhost:5173
APP_ALLOWED_ORIGINS=http://localhost:5173
# Optional audience when your Clerk session tokens include one.
CLERK_AUDIENCE=
API_LISTEN_ADDR=127.0.0.1:8080
# Deliberately public BUILD settings. No secret is allowed in these values.
KAMKM_PUBLIC_ACCOUNTS_ENABLED=false
KAMKM_PUBLIC_CLERK_PUBLISHABLE_KEY=
KAMKM_PUBLIC_API_BASE_URL=
