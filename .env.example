# Server-only configuration. Never expose these through Vite or browser files.
DATABASE_URL=postgres://kamkmchess:replace-me@127.0.0.1:5432/kamkmchess?sslmode=disable
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_AUTHORIZED_PARTIES=http://localhost:5173
APP_ALLOWED_ORIGINS=http://localhost:5173
# Optional audience when your Clerk session tokens include one.
CLERK_AUDIENCE=
API_LISTEN_ADDR=127.0.0.1:8080
# Optional online settings. Build the private worker with pnpm build:rules-worker.
# An empty worker entry leaves rules-dependent online commands unavailable.
ONLINE_RULES_WORKER_ENTRY=
ONLINE_GUEST_CREDENTIAL_TTL=12h
ONLINE_OWNERSHIP_PROOF_TTL=15m
# Finite online update streams. Values above 20s are capped at 20s.
ONLINE_STREAM_MAX_DURATION=20s
# Trusted deadline reconciliation cadence and matches per pass, capped at 1000.
ONLINE_DEADLINE_SWEEP_INTERVAL=1s
ONLINE_DEADLINE_SWEEP_BATCH=100
# The online surfaces are closed by default. A configured service origin is
# never an enablement signal. The two switches are independent.
ONLINE_FRIEND_ENABLED=false
ONLINE_QUEUE_ENABLED=false
# The server's own native Stockfish seat. Off by default; it only plays in
# matches created against it. The path is required when it is on. Build the
# API image with --build-arg WITH_SERVER_ENGINE=1 to include /usr/bin/stockfish.
ONLINE_SERVER_ENGINE_ENABLED=false
ONLINE_SERVER_ENGINE_PATH=
# Concurrent searches, and how often the server looks for a seat to move.
ONLINE_SERVER_ENGINE_SLOTS=2
ONLINE_SERVER_ENGINE_SWEEP_INTERVAL=500ms
# The anonymous remote MCP endpoint at /v1/mcp, where an agent plays the
# server engine. Off by default; it needs the server engine. Trust the
# forwarded client address only behind a proxy that overwrites it.
ONLINE_MCP_ENABLED=false
ONLINE_MCP_MAX_ACTIVE_GAMES=50
ONLINE_MCP_STARTS_PER_HOUR=20
ONLINE_MCP_TRUST_PROXY=false
# The public Community and Verified boards of agent games. Needs the remote
# MCP endpoint. Invite codes for the verified board: go run ./cmd/agentinvite
ONLINE_AGENT_BOARDS_ENABLED=false
# Optional comma-separated account allowlists of the two surfaces. An empty
# list admits every signed-in account. A cohort never excludes a guest: a
# guest has to be able to create a friend link and to accept an invitation
# that was issued while friend play was enabled.
#
# Every token is the opaque account identifier of a signed-in account, for
# example the Clerk user id ("user_2abc...") that the session token carries in
# its "sub" claim. A public username, an email address and a display name are
# not account identifiers: a cohort of them matches no account, so it admits
# nobody while the guests stay admitted. The identifier is private, so the
# value belongs in the server configuration and never in a browser file.
ONLINE_FRIEND_COHORT=
ONLINE_QUEUE_COHORT=
# The durable restore fence. The server refuses to start without this
# setting, because a service that never observes the fence would serve a
# restored database whose removal ledger was never replayed.
#
# The value names the parent directory of the fence marker, not a file: the
# restore writes the marker into <parent>/restore-fence and the service
# refuses to serve while that directory exists. The deployment mounts one
# shared volume at the path below and gives the API and the database service
# the same value, so both observe the same fence.
ONLINE_RESTORE_FENCE_PATH=/var/lib/kamkmchess/restore-fence
# Deliberately public BUILD settings. No secret is allowed in these values.
KAMKM_PUBLIC_ACCOUNTS_ENABLED=false
KAMKM_PUBLIC_CLERK_PUBLISHABLE_KEY=
KAMKM_PUBLIC_API_BASE_URL=
